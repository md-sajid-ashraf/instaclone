<!-- ========================== Side Navbar & Modal ==================== -->

<!-- Sidebar Container -->
<aside
    class="group fixed top-0 left-0 h-screen w-20 hover:w-64 bg-black border-r border-zinc-900 flex flex-col justify-between py-8 px-3 z-40 text-white transition-all duration-300 ease-in-out overflow-hidden">

    <!-- Top Section (Logo & Nav Links) -->
    <div class="flex flex-col space-y-6">
        <div class="px-2 mb-2 flex items-center">
            <a href="/feed" class="flex items-center space-x-3 overflow-hidden">
                <i class="fab fa-instagram text-2xl text-white min-w-[32px] text-center"></i>
                <img class="w-24 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap"
                    src="/images/Instagram-logo-.png"
                    alt="Instagram">
            </a>
        </div>

        <nav class="flex flex-col space-y-2 text-white">
            <a href="/feed" class="flex items-center space-x-4 p-3 rounded-xl hover:bg-zinc-900 transition group/item">
                <i
                    class="fas fa-house text-xl text-zinc-100 min-w-[32px] text-center group-hover/item:scale-105 transition"></i>
                <span
                    class="text-sm font-medium text-zinc-100  group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Home</span>
            </a>

            <a href="#search"
                class="flex items-center space-x-4 p-3 rounded-xl hover:bg-zinc-900 transition group/item">
                <i
                    class="fas fa-search text-xl text-zinc-100 min-w-[32px] text-center group-hover/item:scale-105 transition"></i>
                <span
                    class="text-sm font-medium text-zinc-100  group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Search</span>
            </a>

            <div onclick="openModal()"
                class="flex items-center space-x-4 p-3 rounded-xl hover:bg-zinc-900 transition group/item cursor-pointer">
                <i
                    class="far fa-square-plus text-xl text-zinc-100 min-w-[32px] text-center group-hover/item:scale-105 transition"></i>
                <span
                    class="text-sm font-medium text-zinc-100  group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Create</span>
            </div>

            <a href="#reels" class="flex items-center space-x-4 p-3 rounded-xl hover:bg-zinc-900 transition group/item">
                <i
                    class="fas fa-clapperboard text-xl text-zinc-100 min-w-[32px] text-center group-hover/item:scale-105 transition"></i>
                <span
                    class="text-sm font-medium text-zinc-100  group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Reels</span>
            </a>

            <a href="#notification"
                class="flex items-center space-x-4 p-3 rounded-xl hover:bg-zinc-900 transition group/item">
                <i
                    class="far fa-heart text-xl text-zinc-100 min-w-[32px] text-center group-hover/item:scale-105 transition"></i>
                <span
                    class="text-sm font-medium text-zinc-100  group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Notification</span>
            </a>

            <a href="/profile"
                class="flex items-center space-x-4 p-3 rounded-xl hover:bg-zinc-900 transition group/item">
                <i
                    class="fas fa-user text-xl text-zinc-100 min-w-[32px] text-center group-hover/item:scale-105 transition"></i>
                <span
                    class="text-sm font-medium text-zinc-100  group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Profile</span>
            </a>
        </nav>
    </div>

    <div>
        <a href="/logout"
            class="flex items-center space-x-4 p-3 rounded-xl hover:bg-zinc-900 transition group/item text-red-400">
            <i class="fas fa-sign-out text-xl min-w-[32px] text-center group-hover/item:scale-105 transition"></i>
            <span
                class="text-sm font-medium  group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Logout</span>
        </a>
    </div>
</aside>

<!-- Modal Overlay -->
<div id="modal" onclick="overlayClick(event)"
    class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-sm flex items-center justify-center text-white">

    <!-- Close Button (Top Right Corner) -->
    <button onclick="closeModal()" class="absolute top-5 right-6 text-zinc-400 hover:text-white transition">
        <i class="fa fa-times text-2xl"></i>
    </button>

    <!-- Modal Container -->
    <form action="/addpost" method="post" enctype="multipart/form-data"
        class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden shadow-2xl">
        <div class="w-[800px] h-[480px] relative overflow-hidden" onclick="event.stopPropagation()">

            <!-- Slider Wrapper -->
            <div id="slider" class="flex w-[1600px] h-full transition-transform duration-300 ease-in-out">

                <!-- Step 1: Image Upload -->
                <div class="w-[800px] flex flex-col h-full">

                    <!-- Header -->
                    <div class="flex justify-between items-center px-4 py-3 border-b border-zinc-800 bg-zinc-950">
                        <button type="button" onclick="closeModal()"
                            class="text-sm text-zinc-400 hover:text-white font-medium">Cancel</button>
                        <p class="text-sm font-semibold tracking-wide">Create new post</p>
                        <button type="button" id="nextBtn" onclick="nextStep()"
                            class="text-sm text-zinc-500 hover:text-sky-400 font-semibold" disabled>Next</button>
                    </div>

                    <!-- Upload Area -->
                    <input type="file" accept="image/*" id="fileInput" name="postImage" hidden>
                    <div id="previewContainer2"
                        class="m-6 flex-1 border-2 border-dashed border-zinc-700 rounded-xl flex items-center justify-center hover:bg-zinc-800/50 transition cursor-pointer relative overflow-hidden">

                        <div id="uploadContent" class="flex flex-col items-center text-zinc-400 space-y-3">
                            <i class="fa fa-cloud-upload text-5xl"></i>
                            <p class="text-sm font-medium text-zinc-200">Drag photos and videos here</p>
                            <label for="fileInput"
                                class="bg-sky-500 hover:bg-sky-600 transition px-4 py-2 text-xs font-semibold text-white rounded-lg cursor-pointer shadow-md">Select
                                from computer</label>
                        </div>
                    </div>

                </div>

                <!-- Step 2: Details Section -->
                <div class="w-[800px] flex flex-col h-full bg-zinc-900">

                    <!-- Header -->
                    <div class="flex justify-between items-center px-4 py-3 border-b border-zinc-800 bg-zinc-950">
                        <button type="button" onclick="prevStep()"
                            class="text-sm text-zinc-400 hover:text-white font-medium flex items-center gap-1">
                            <i class="fa fa-arrow-left"></i> Back
                        </button>
                        <p class="text-sm font-semibold tracking-wide">Create info</p>
                        <button type="submit" onclick="console.log('form submitted')"
                            class="text-sm text-sky-500 hover:text-sky-400 font-semibold">Share</button>
                    </div>

                    <!-- Content -->
                    <div class="p-6 flex gap-5 h-[calc(100%-53px)]">

                        <!-- Image Preview -->
                        <div id="previewContainer"
                            class="w-3/5 bg-zinc-950 rounded-lg flex items-center justify-center overflow-hidden border border-zinc-800">
                            <span class="text-xs text-zinc-500">Image Preview</span>
                        </div>

                        <!-- Details Form -->
                        <div class="w-2/5 flex flex-col space-y-4">
                            <div class="flex items-center space-x-3">
                                <div class="w-8 h-8 rounded-full bg-zinc-700 overflow-hidden">
                                    <!-- User avatar mini can go here -->
                                </div>
                                <span class="text-sm font-semibold text-zinc-200">
                                    <%= user ? user.username : 'Username' %>
                                </span>
                            </div>
                            <textarea name="caption"
                                class="w-full flex-1 bg-zinc-950 text-sm p-3 border border-zinc-800 rounded-lg resize-none focus:outline-none focus:border-zinc-600 text-zinc-200 placeholder-zinc-500"
                                placeholder="Write a caption..."></textarea>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </form>
</div>

<script>
    const modal = document.getElementById("modal");
    const slider = document.getElementById("slider");
    const fileInput = document.getElementById('fileInput');
    const nextBtn = document.getElementById('nextBtn');

    // File input par listener lagayein
    fileInput.addEventListener('change', function () {
        // Check karein ki koi file select ki gayi hai ya nahi
        if (fileInput.files.length > 0) {
            nextBtn.removeAttribute('disabled'); // Button enable ho jayega
            nextBtn.classList.remove('text-zinc-500');
            nextBtn.classList.add('text-sky-500');
        } else {
            nextBtn.setAttribute('disabled', 'true'); // Agar file hata di toh fir se disable ho jayega
        }
    });


    const previewContainer = document.getElementById("previewContainer");
    const previewContainer2 = document.getElementById("previewContainer2");
    const uploadContent = document.getElementById("uploadContent");

    fileInput.addEventListener("change", function () {
        previewContainer.innerHTML = "";
        previewContainer2.innerHTML = "";

        const files = this.files;

        Array.from(files).forEach((file) => {
            if (!file.type.startsWith("image/")) return;

            // 1. Blob/Object URL banayein
            const objectURL = URL.createObjectURL(file);

            // 2. Pehla image element
            const img1 = document.createElement("img");
            img1.src = objectURL;
            img1.classList.add("w-full", "h-full", "object-contain", "rounded-lg", "shadow");

            // 3. Doosra image element
            const img2 = document.createElement("img");
            img2.src = objectURL;
            img2.classList.add("w-full", "h-full", "object-contain", "rounded-lg", "shadow");

            // Containers mein append karein
            previewContainer.appendChild(img1);
            previewContainer2.appendChild(img2);
        });
    });

    function openModal() {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
    }

    function closeModal() {
        fileInput.value = "";

        // Remove upload image
        const img1 = previewContainer.querySelector("img");
        if (img1) img1.remove();

        const img2 = previewContainer2.querySelector("img");
        if (img2) img2.remove();

        // Disable next button
        nextBtn.setAttribute('disabled', 'true');
        nextBtn.classList.remove('text-sky-500');
        nextBtn.classList.add('text-zinc-500');

        // Show Upload content div
        if (previewContainer2) previewContainer2.innerHTML = "<div id='uploadContent' class='flex flex-col items-center text-zinc-400 space-y-3'><i class='fa fa-cloud-upload text-5xl'></i><p class='text-sm font-medium text-zinc-200'>Drag photos and videos here</p><label for='fileInput' class='bg-sky-500 hover:bg-sky-600 transition px-4 py-2 text-xs font-semibold text-white rounded-lg cursor-pointer shadow-md'>Select from computer</label></div>";
        
        // Close modal box
        modal.classList.add("hidden");
        slider.style.transform = "translateX(0px)";
    }

    function nextStep() {
        slider.style.transform = "translateX(-800px)";
    }

    function prevStep() {
        slider.style.transform = "translateX(0px)";
    }

    function overlayClick(event) {
        if (event.target.id === "modal") {
            closeModal();
        }
    }
</script>