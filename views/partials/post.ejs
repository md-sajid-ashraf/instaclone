<!-- Modal Overlay -->
<div id="modal" onclick="overlayClick(event)"
    class="fixed inset-0 z-50 hidden bg-black/60 flex items-center justify-center">

    <!-- Modal Container -->
    <div class="bg-gray-800 w-[800px] h-[500px] rounded-xl overflow-hidden relative" onclick="event.stopPropagation()">



        <!-- Slider Wrapper -->
        <div id="slider" class="flex w-[1600px] h-full transition-transform duration-500 ease-in-out">

            <!-- Step 1: Image Upload -->
            <div class="w-[800px] p-6 flex flex-col">
                <div class="flex justify-end items-center mb-6">
                    <!-- Close Button (Top Right Corner) -->
                    <button onclick="closeModal()"
                        class="absolute top-4 right-4 text-gray-500 hover:text-black text-2xl">
                        ✕
                    </button>
                </div>
                <!-- Header -->
                <div class="flex justify-between items-center mb-6">
                    <button onclick="closeModal()" class="text-gray-600 font-medium">Back</button>
                    <button onclick="nextStep()" class="text-blue-600 font-medium">Next</button>
                </div>

                <!-- Upload Area -->
                <div class="flex-1 border-2 border-dashed border-gray-300 rounded-lg 
                      flex items-center justify-center cursor-pointer ">
                    <input type="file" multiple class="hidden" id="fileInput">
                    <label for="fileInput" class="text-gray-500 cursor-pointer">
                        Drag & Drop Images or Click to Upload
                    </label>
                </div>

            </div>

            <!-- Step 2: Details Section -->
            <div class="w-[800px] p-6 flex flex-col bg-gray-50">

                <!-- Header -->
                <div class="flex justify-between items-center mb-6">
                    <button onclick="prevStep()" class="text-blue-600 font-medium">Back</button>
                    <button class="text-green-600 font-medium">Share</button>
                </div>

                <!-- Content -->
                <div class="flex gap-6 h-full">

                    <!-- Image Preview -->
                    <div class="w-1/2 bg-gray-200 rounded-lg flex items-center justify-center">
                        <span class="text-gray-500">Image Preview</span>
                    </div>

                    <!-- Details -->
                    <div class="w-1/2 flex flex-col">
                        <h2 class="font-semibold mb-2">Username</h2>
                        <textarea
                            class="flex-1 p-3 border rounded-lg resize-none focus:outline-none focus:ring-2 focus:ring-blue-400"
                            placeholder="Write a description..."></textarea>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

<script>
    const modal = document.getElementById("modal");
    const slider = document.getElementById("slider");

    function openModal() {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
    }

    function closeModal() {
        modal.classList.add("hidden");
        slider.style.transform = "translateX(0px)";
    }

    function nextStep() {
        slider.style.transform = "translateX(-750px)";
    }

    function prevStep() {
        slider.style.transform = "translateX(0px)";
    }

    function overlayClick(event) {
        if (event.target.id === "modal") {
            closeModal();
        }
    }
</script>