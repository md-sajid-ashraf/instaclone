<div class="main text-white">
  <div>
    <img class="main-img" src="/images/img2.png" alt="">
  </div>
  <div class="mx-4">
    <h1 class="text-center text-white">Sign Up</h1>
    <form action="/signup" method="post">
      <div class="row">
        <div class="input-box my-1 col-6 ">
          <label class="my-1 text-sm" for="fname">First name</label>
          <input class="p-2 w-100 bg-dark text-white border-0 rounded" type="text" name="fname" id="fname" required>
        </div>
        <div class="input-box my-1 col-6">
          <label class="my-1 text-sm" for="lname">Last name</label>
          <input class="p-2 w-100 bg-dark text-white border-0 rounded" type="text" name="lname" id="lname" required>
        </div>
      </div>
      <div class="row">
        <div class="input-box my-1 col-6">
          <label class="my-1 text-sm" for="username">Username</label>
          <input class="p-2 w-100 bg-dark text-white border-0 rounded" type="text" name="username" id="username"
            required>
        </div>
        <div class="input-box my-1 col-6">
          <label class="my-1 text-sm" for="email">Email</label>
          <input class="p-2 w-100 bg-dark text-white border-0 rounded" type="text" name="email" id="email" required>
        </div>
      </div>
      <div class="row">
        <div class="input-box my-1 col-6">
          <label class="my-1 text-sm" for="dob">DOB</label>
          <input class="p-2 w-100 bg-dark text-white border-0 rounded" type="date" name="dob" id="dob" required>
        </div>
        <div class="input-box my-1 col-6">
          <label class="my-1 text-sm" for="phone">Phone number</label>
          <input class="p-2 w-100 bg-dark text-white border-0 rounded" type="text" name="phone" id="phone" required>
        </div>
      </div>
      <div class="input-box my-1">
        <label class="my-1 text-sm" for="password">Password</label>
        <input class="p-2 w-100 bg-dark text-white border-0 rounded" type="password" name="password" id="password"
          required>
      </div>
      <button class="w-100 mt-4 btn btn-primary" type="submit">Sign Up</button>
      <p class="mt-2 text-white text-center">Already have an account? <a href="/">Sign In</a></p>
    </form>
    <!-- <img class="img-thumbnail" src="/images/img1.png" alt=""> -->
  </div>
</div>