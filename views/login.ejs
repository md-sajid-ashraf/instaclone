    <div class="mx-4">
      <div class="my-4 d-flex align-items-center justify-content-center">
        <img class="mx-2 main-logo" src="/images/instaLogo.png" alt="">
        <img class="brand-name" src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/2a/Instagram_logo.svg/1200px-Instagram_logo.svg.png" alt="brand-name" width="150"></a>
