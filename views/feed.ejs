<!-- Body of the page -->
<!-- Main Feed View -->
<div class="flex w-full">
    <main class="ml-20 min-h-screen w-full bg-black text-white py-4 px-6 flex justify-center">
        <div class="w-full max-w-[470px]">

            <!-- Story Section -->
            <div
                class="flex space-x-4 overflow-x-auto pb-4 scrollbar-none mb-6 overflow-x-auto whitespace-nowrap no-scrollbar">
                <% for(let i=0; i<12; i++) { %>
                    <div class="flex flex-col items-center space-y-1 cursor-pointer flex-shrink-0">
                        <div
                            class="w-16 h-16 rounded-full p-[2px] bg-gradient-to-tr from-yellow-500 via-pink-500 to-purple-600">
                            <div class="w-full h-full rounded-full border-2 border-black overflow-hidden bg-black">
                                <img class="w-full h-full object-cover" src="/images/insta_logo.png" alt="Story">
                            </div>
                        </div>
                        <span class="text-xs text-zinc-400 truncate w-16 text-center">John Done</span>
                    </div>
                    <% } %>
            </div>

            <!-- Posts Section -->
            <% posts.forEach(post=> { %>
                <div class="bg-black mb-6 overflow-hidden">
                    <div class="flex items-center justify-between px-2 py-3">
                        <div class="flex items-center space-x-3">
                            <div class="w-9 h-9 rounded-full p-[2px] bg-gradient-to-tr from-yellow-500 to-pink-500">
                                <div class="w-full h-full rounded-full border border-black overflow-hidden bg-black">
                                    <img class="w-full h-full object-cover" src="/images/profiles/<%= post.user.profileImage %>" alt="">
                                </div>
                            </div>
                            <span class="font-semibold text-sm text-zinc-200">
                                <%= post.user.username %>
                            </span>
                        </div>
                        <button class="text-zinc-400 hover:text-white transition">
                            <i class="fas fa-ellipsis-h"></i>
                        </button>
                    </div>

                    <div
                        class="w-full bg-zinc-950 flex items-center justify-center max-h-[550px] overflow-hidden border-0 rounded-md">
                        <img class="w-full h-auto object-cover" src="/images/uploads/<%= post.postImage %>" alt="Post">
                    </div>

                    <div class="px-2 pt-3 pb-2 flex items-center justify-between">
                        <div class="flex items-center space-x-4">
                            <button class="flex items-center space-x-1.5 text-zinc-200 hover:text-red-500 transition">
                                <i class="fa-regular fa-heart text-xl"></i>
                                <span class="text-sm font-semibold"><%= post.likes?.length || 0 %> </span>
                            </button>
                            <button class="flex items-center space-x-1.5 text-zinc-200 hover:text-blue-400 transition">
                                <i class="fa-regular fa-comment text-xl"></i>
                                <span class="text-sm font-semibold">1</span>
                            </button>
                            <button class="text-zinc-200 hover:text-green-400 transition">
                                <i class="fa-solid fa-paper-plane"></i>

                            </button>
                        </div>
                    </div>

                    <div class="px-4 pb-4 text-sm flex items-start space-x-2">
                        <span class="font-semibold text-zinc-200">
                            <%= post.user.username %>
                        </span>
                        <span class="text-zinc-300">
                            <%= post.caption %>
                        </span>
                    </div>
                </div>
                <% }) %>

        </div>
    </main>

    <!-- Third sidebar -->
    <div class="hidden lg:block w-80 p-4 text-white border-l border-zinc-800 bg-black">

        <!-- Current User Profile Row -->
        <div class="flex items-center justify-between my-4">
            <div class="flex items-center space-x-3">
                <div class="w-14 h-14 rounded-full overflow-hidden bg-zinc-800">
                    <img class="w-full h-full object-cover" src="/images/profiles/<%= user.profileImage %>" alt="">
                </div>
                <div>
                    <a href="/profile" class="font-semibold text-sm text-zinc-200 hover:underline">
                        <%= user.username %>
                    </a>
                    <p class="text-xs text-zinc-400">
                        <%= user.fname %>
                            <%= user.lname %>
                    </p>
                </div>
            </div>
            <button class="text-xs font-semibold text-blue-500 hover:text-blue-400">Switch</button>
        </div>

        <!-- Suggested Header -->
        <div class="flex items-center justify-between my-4">
            <span class="text-xs font-bold text-zinc-400 tracking-wide">Suggested for you</span>
            <button class="text-xs font-semibold text-zinc-200 hover:text-white">See All</button>
        </div>

        <!-- User Suggestion List -->
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full overflow-hidden">
                        <img class="w-full h-full object-cover" src="/images/p1.jpg" alt="">
                    </div>
                    <div>
                        <p class="text-xs font-semibold text-zinc-200">afreenroquiya41</p>
                        <p class="text-[11px] text-zinc-400">Followed by _sid_9852</p>
                    </div>
                </div>
                <button class="text-xs font-semibold text-blue-500 hover:text-white transition">Follow</button>
            </div>

            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full overflow-hidden">
                        <img class="w-full h-full object-cover" src="/images/p2.jpg" alt="">
                    </div>
                    <div>
                        <p class="text-xs font-semibold text-zinc-200">rehanakhatoon8982</p>
                        <p class="text-[11px] text-zinc-400">Followed by amir001__</p>
                    </div>
                </div>
                <button class="text-xs font-semibold text-blue-500 hover:text-white transition">Follow</button>
            </div>

            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full overflow-hidden">
                        <img class="w-full h-full object-cover" src="/images/p3.jpg" alt="">
                    </div>
                    <div>
                        <p class="text-xs font-semibold text-zinc-200">md.arif8535</p>
                        <p class="text-[11px] text-zinc-400">Followed by raziyaparween585</p>
                    </div>
                </div>
                <button class="text-xs font-semibold text-blue-500 hover:text-white transition">Follow</button>
            </div>

            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full overflow-hidden">
                        <img class="w-full h-full object-cover" src="/images/p4.png" alt="">
                    </div>
                    <div>
                        <p class="text-xs font-semibold text-zinc-200">mdwakash6</p>
                        <p class="text-[11px] text-zinc-400">Followed by md.arman.alam585</p>
                    </div>
                </div>
                <button class="text-xs font-semibold text-blue-500 hover:text-white transition">Follow</button>
            </div>
        </div>

        <!-- Footer Links -->
        <div class="mt-6 text-[11px] text-zinc-500 leading-relaxed">
            <p>About &bull; Help &bull; Press &bull; API &bull; Jobs &bull; Privacy &bull; Terms &bull; Location &bull;
                Language &bull; Meta Verified</p>
            <p class="mt-3">&copy; 2025 INTAGRAM FROM META</p>
        </div>

    </div>
</div>