<% include ./partials/header.ejs %>
    <div class="main text-white">
        <div class="d-flex flex-column border border-1 border-secondary rounded">
            <div class="my-3 mx-auto d-flex align-items-center justify-content-center border border-2 border-white rounded-circle"
                style="width: 100px; height: 100px;">
                <i class="fas fa-lock" style="font-size: 42px;"></i>
            </div>
            <div class="mx-4 text-center">
                <p class="my-1 fw-bolder"> Trouble with logging in?</p>
                <p class="my-2 text-break fs-12">Enter your email address, phone number or <br> username, and we'll send
                    you OTP to get back <br> into your account.</p>
            </div>
            <form action="/accounts/password/reset" method="post">
                <div class="input-box my-1 mx-4">
                    <input class="p-3 w-100 bg-dark text-white border-0 rounded-4" type="username" name="username"
                        id="username" placeholder="Enter username or phone number">
                    </p>
                </div>
                <div class="mt-3 mx-4 d-flex align-items-center justify-content-center">
                    <button class="w-100 btn btn-primary rounded-5" type="submit">Continue</button>
                </div>
                <p class="mt-2 text-white text-center fs-10"> <a class="text-light text-decoration-none"
                        href="#cantreset">Can't reset your password?</a>
                    <hr class="mx-4">

                <p class="mt-2 text-white text-center fw-bolder"><a class="text-light text-decoration-none"
                        href="/signup">Create New account</a></p>
                <div class="mt-5 py-1 bg-gradient">
                    <p class="mt-2 text-white text-center fw-bolder"><a class="text-light text-decoration-none"
                            href="/">Back to Login</a></p>
                </div>
            </form>
        </div>
    </div>
    <% include ./partials/footer.ejs %>